{#
  Riverside packs each score into a 30-slot array holding one value per Appendix A test.
  `fwf_to_csv_xwalks/iowa_fwf_xwalk.csv` splits every array into one column per test,
  named `<prefix>__<test>` (`<prefix>_<test>` once snake-cased), so this template reads a column per score rather than slicing
  a packed string.
#}
{% set level_num = level | int %}

{# (Appendix A slot, identification code, column suffix, is a composite).

   Composites are reported on the student assessment itself rather than as objective
   assessments. Slot 6 is Language through level 08 and Written Expression above it;
   slots 25 and 26 only exist at level 06. #}
{% set tests = [
  ( 1, "R",    "reading",                                 false),
  ( 2, "V",    "vocabulary",                              false),
  ( 3, "SP",   "spelling",                                false),
  ( 4, "CP",   "capitalization",                          false),
  ( 5, "PC",   "punctuation",                             false),
  ( 6, ("L" if level_num <= 8 else "WE"), "language_written_expression", false),
  ( 7, "CW",   "conventions_of_writing",                  false),
  ( 8, "ET",   "ela_total",                               false),
  ( 9, "WA",   "word_analysis",                           false),
  (10, "Li",   "listening",                               false),
  (11, "XET",  "extended_ela_total",                      false),
  (12, "M",    "math",                                    false),
  (13, "MC",   "computation",                             false),
  (14, "MT",   "math_total",                              false),
  (15, "CT",   "core_composite",                          true ),
  (16, "XCT",  "core_composite_extended_ela",             true ),
  (17, "CT-",  "core_composite_no_comp",                  true ),
  (18, "XCT-", "core_composite_extended_ela_no_comp",     true ),
  (19, "SS",   "social_studies",                          false),
  (20, "SC",   "science",                                 false),
  (21, "CC",   "complete_composite",                      true ),
  (22, "XCC",  "complete_composite_extended_ela",         true ),
  (23, "CC-",  "complete_composite_no_comp",              true ),
  (24, "XCC-", "complete_composite_extended_ela_no_comp", true ),
  (25, "RW",   "reading_words",                           false),
  (26, "RC",   "reading_comprehension",                   false),
  (27, "RT",   "reading_total",                           false),
  (28, "LT",   "language_total",                          false)
] %}

{# (column prefix, reporting method descriptor, result data type) -- one entry per
   Appendix A array in the layout. #}
{% set indexed_scores = [
  ("number_attempted_na",                     "Number Attempted",                   "Integer"   ),
  ("raw_score_rs",                            "Raw Score",                          "Integer"   ),
  ("standard_score_ss",                       "Standard Score",                     "Integer"   ),
  ("grade_equivalent_ge",                     "Grade Equivalent",                   "Decimal"   ),
  ("national_percentile_rank_npr",            "National Percentile Rank",           "Percentile"),
  ("national_curve_equivalent_nce",           "National Curve Equivalent",          "Percentile"),
  ("national_stanine_ns",                     "National Stanine",                   "Integer"   ),
  ("pr_valid_flag",                           "PR Valid Flag",                      "Integer"   ),
  ("predicted_standard_score_pss",            "Predicted Standard Score",           "Integer"   ),
  ("predicted_grade_equivalent_pge",          "Predicted Grade Equivalent",         "Decimal"   ),
  ("predicted_national_percentile_rank_pnpr", "Predicted National Percentile Rank", "Percentile"),
  ("predicted_standard_score_diffs",          "Predicted Standard Score Diffs",     "Integer"   ),
  ("predicted_grade_equivalent_diffs",        "Predicted Grade Equivalent Diffs",   "Decimal"   ),
  ("significant_diff_indicators_68",          "Significant Diff Indicator 68",      "Integer"   ),
  ("significant_diff_indicators_80",          "Significant Diff Indicator 80",      "Integer"   ),
  ("significant_diff_indicators_90",          "Significant Diff Indicator 90",      "Integer"   ),
  ("local_percentile_rank",                   "Local Percentile Rank",              "Percentile"),
  ("local_stanines",                          "Local Stanine",                      "Integer"   ),
  ("catholic_private_pr",                     "Catholic - Private PR",              "Percentile"),
  ("hses_pr",                                 "HSES PR",                            "Percentile"),
  ("lses_pr",                                 "LSES PR",                            "Percentile"),
  ("college_readiness",                       "College Readiness",                  "Level"     ),
  ("state_predicted_scale_score_low",         "SPSS: Low Score of Range",           "Integer"   ),
  ("state_predicted_scale_score_high",        "SPSS: High Score of Range",          "Integer"   ),
  ("state_predicted_scale_score",             "State Predicted Scale Score",        "Integer"   )
] %}

{% set norm_basis = {"2011": "2005", "2017": "2011", "2024": "2017"}.get(norm_year) %}
{% if norm_basis %}
  {% set indexed_scores = indexed_scores + [
    ("standard_score_norm_based",              "Standard Score based on "           ~ norm_basis ~ " norms", "Integer"   ),
    ("grade_equivalent_norm_based",            "Grade Equivalent based on "         ~ norm_basis ~ " norms", "Decimal"   ),
    ("national_percentile_rank_norm_based",    "National Percentile Rank based on " ~ norm_basis ~ " norms", "Percentile"),
    ("national_stanine_norm_based",            "National Stanine based on "         ~ norm_basis ~ " norms", "Integer"   )
  ] %}
{% endif %}

{# Scores that describe the whole test rather than one Appendix A slot. #}
{% set flat_scores = [
  ("predicted_sat_critical_reading_high", "Predicted SAT Critical Reading High", "Integer"),
  ("predicted_sat_critical_reading_low",  "Predicted SAT Critical Reading Low",  "Integer"),
  ("predicted_sat_math_high",             "Predicted SAT Math High",             "Integer"),
  ("predicted_sat_math_low",              "Predicted SAT Math Low",              "Integer"),
  ("predicted_act_composite_high",        "Predicted ACT Composite High",        "Integer"),
  ("predicted_act_composite_low",         "Predicted ACT Composite Low",         "Integer"),
  ("battery",                             "Battery",                             "Level"  ),
  ("level",                               "Level",                               "Level"  ),
  ("form",                                "Form",                                "Level"  ),
  ("norm_year",                           "Norm Year",                           "Level"  )
] %}

{% set accommodations = [
  ("00", "Online desktop or laptop"),
  ("01", "Online tablet"),
  ("04", "Braille"),
  ("05", "Large Print"),
  ("06", "Proctor led"),
  ("07", "Self-paced"),
  ("08", "Audio Type"),
  ("09", "English Language Administration"),
  ("10", "Spanish Language Administration"),
  ("11", "Extended Time")
] %}

{%- set marked = [] -%}
{%- for position, descriptor in accommodations -%}
  {%- if __row_data__.get("mode_of_administration_" ~ position, "") | trim == "1" -%}
    {%- set _ = marked.append(descriptor) -%}
  {%- endif -%}
{%- endfor -%}

{
  "studentAssessmentIdentifier": "{{student_assessment_identifier}}",
  "assessmentReference": {
    "assessmentIdentifier": "{{assessmentIdentifier}}",
    "namespace": "{{namespace}}"
  },
  "schoolYearTypeReference": {
    "schoolYear": {{school_year}}
  },
  "studentReference": {
    "studentUniqueId": "{{student_unique_id}}"
  },
  "administrationDate": "{{date_tested}}",
  "period": {
    "assessmentPeriodDescriptor": "{{namespace}}/AssessmentPeriodDescriptor#{{semester}}"
  },
  "whenAssessedGradeLevelDescriptor": "{{class_grade}}",
  "serialNumber": "{{serial_number}}",

  {% if marked %}
  "accommodations": [
    {% for descriptor in marked %}
    {
      "accommodationDescriptor": "{{namespace}}/AccommodationDescriptor#{{descriptor}}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  {% endif %}

  "studentObjectiveAssessments": [
    {% set composite_scores = [] %}
    {% set state = {"emitted": false} %}
    {% for slot, code, column, is_composite in tests %}

      {% set results = [] %}
      {% for prefix, method, datatype in indexed_scores %}
        {% set result = __row_data__.get(prefix ~ "_" ~ column, "") | trim %}
        {% if result and result != "NULL" and "/" not in result and "-" not in result[1:] and "e" not in result | lower %}
          {% set _ = results.append({
            "method": (method ~ "/" ~ code) if is_composite else method,
            "datatype": datatype,
            "result": result
          }) %}
        {% endif %}
      {% endfor %}

      {% if is_composite %}
        {% set _ = composite_scores.extend(results) %}
      {% else %}
        {% if state.emitted %},{% endif %}
        {% if state.update({"emitted": true}) %}{% endif %}
        {
          "objectiveAssessmentReference": {
            "assessmentIdentifier": "{{assessmentIdentifier}}",
            "identificationCode": "{{code}}",
            "namespace": "{{namespace}}"
          },
          {% set completion = __row_data__.get("completion_criteria_cc_" ~ column, "") | trim %}
          {% if completion %}
          "performanceLevels": [
            {
              "assessmentReportingMethodDescriptor": "{{namespace}}/AssessmentReportingMethodDescriptor#Completion Criteria",
              "performanceLevelDescriptor": "{{namespace}}/PerformanceLevelDescriptor#{{completion}}",
              "performanceLevelMet": {{ "true" if completion == "1" else "false" }}
            }
          ],
          {% endif %}
          "scoreResults": [
            {% for score in results %}
            {
              "assessmentReportingMethodDescriptor": "{{namespace}}/AssessmentReportingMethodDescriptor#{{score.method}}",
              "resultDatatypeTypeDescriptor": "{{descriptor_namespace_override}}/ResultDatatypeTypeDescriptor#{{score.datatype}}",
              "result": "{{score.result}}"
            }{% if not loop.last %},{% endif %}
            {% else %}
            {
              "assessmentReportingMethodDescriptor": "{{namespace}}/AssessmentReportingMethodDescriptor#No Score",
              "resultDatatypeTypeDescriptor": "{{descriptor_namespace_override}}/ResultDatatypeTypeDescriptor#Level",
              "result": "No Score"
            }
            {% endfor %}
          ]
        }
      {% endif %}
    {% endfor %}
  ],

  "scoreResults": [
    {% for name, method, datatype in flat_scores %}
      {% set result = __row_data__.get(name, "") | trim %}
      {% if result and result != "NULL" %}
        {% set _ = composite_scores.append({"method": method, "datatype": datatype, "result": result}) %}
      {% endif %}
    {% endfor %}
    {% for score in composite_scores %}
    {
      "assessmentReportingMethodDescriptor": "{{namespace}}/AssessmentReportingMethodDescriptor#{{score.method}}",
      "resultDatatypeTypeDescriptor": "{{descriptor_namespace_override}}/ResultDatatypeTypeDescriptor#{{score.datatype}}",
      "result": "{{score.result}}"
    }{% if not loop.last %},{% endif %}
    {% else %}
    {
      "assessmentReportingMethodDescriptor": "{{namespace}}/AssessmentReportingMethodDescriptor#No Score",
      "resultDatatypeTypeDescriptor": "{{descriptor_namespace_override}}/ResultDatatypeTypeDescriptor#Level",
      "result": "No Score"
    }
    {% endfor %}
  ]
}
