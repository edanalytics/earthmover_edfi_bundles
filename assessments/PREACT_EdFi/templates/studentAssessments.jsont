{
    "studentAssessmentIdentifier": "{{student_assessment_identifier}}",
    "assessmentReference": {
      "assessmentIdentifier": "{{assessment_identifier}}",
      "namespace": "{{namespace}}"
    },
    "schoolYearTypeReference": {
      "schoolYear": {{school_year}}
    },
    "studentReference": {
      "studentUniqueId": "{{studentUniqueId}}"
    },
    "administrationDate": "{{administration_date}}",
    "whenAssessedGradeLevelDescriptor": "{{gradeLevelDescriptor}}",
    
    {% set pls_to_keep = [namespace ~ 'AssessmentReportingMethodDescriptor#Composite Score'] %}
    {% set kept_pls = [] %}
    {% for item in fromjson(v_performance_levels | default('[]', true)) %}
      {% if item.assessmentReportingMethodDescriptor in pls_to_keep %}
        {% set _= kept_pls.append(item) %}
      {% endif %}
    {% endfor %}
    "performanceLevels": [
      {% for item in kept_pls %}
          {
            "assessmentReportingMethodDescriptor": "{{namespace}}AssessmentReportingMethodDescriptor#Progress Toward Career Readiness Indicator",
            "performanceLevelDescriptor": "{{item.performanceLevelDescriptor}}",
            "performanceLevelMet": true
          }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],

    {% set subscores_to_remove_from_scores = [namespace ~ 'AssessmentReportingMethodDescriptor#STEM Score',
                                           namespace ~ 'AssessmentReportingMethodDescriptor#STEM US Rank',
                                           namespace ~ 'AssessmentReportingMethodDescriptor#STEM Score Range High',
                                           namespace ~ 'AssessmentReportingMethodDescriptor#STEM Score Range Low',
                                           ] %}
    {% set kept_scores = [] %}
    {% for item in fromjson(v_score_results | default('[]', true)) %}
      {% if item.assessmentReportingMethodDescriptor not in subscores_to_remove_from_scores %}
        {% set _= kept_scores.append(item) %}
      {% endif %}
    {% endfor %}
    "scoreResults": [
      {% for item in kept_scores %}
         {
            "assessmentReportingMethodDescriptor": "{{item.assessmentReportingMethodDescriptor}}",
            "resultDatatypeTypeDescriptor": "{{item.resultDatatypeTypeDescriptor.replace('uri://ed-fi.org',descriptor_namespace)}}",
            "result": "{{item.result}}"
         }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],

    "studentObjectiveAssessments": [
      {%- set obj_comma = joiner(',') -%}
      {%- set stem_id = assessment_identifier | replace('-', '') ~ '_STEM' -%}
      {%- set topline_obj_assess = [[stem_id,
                                   {
                                    'Scale Score':PREACT_STEM_scale_score,
                                    'US Rank':PREACT_STEM_us_rank,
                                    'Scale Score Range High':PREACT_STEM_score_range_high,
                                    'Scale Score Range Low':PREACT_STEM_score_range_low
                                   },
                                   namespace ~ 'AssessmentReportingMethodDescriptor#STEM Score']
                               ] -%}

      {%- for obj in topline_obj_assess -%}
      {%- set all_score_obj = [] -%}
        {%- for score_name, score_result in obj[1].items() -%}
          {%- if score_result != '' -%}
            {%- set _= all_score_obj.append([score_name, score_result, 'Percentile' if score_name == 'US Rank' else 'Integer']) -%}
          {%- endif -%}
        {%- endfor -%}
  
      {%- if all_score_obj|length > 0 -%}
      {{ obj_comma() }}
      {
        "objectiveAssessmentReference": {
          "assessmentIdentifier": "{{assessment_identifier}}",
          "identificationCode": "{{obj[0]}}",
          "namespace": "{{namespace}}"
        },
        {%- set obj_pls = [] -%}
        {%- for level in fromjson(v_performance_levels | default('[]', true)) -%}
          {%- if level.assessmentReportingMethodDescriptor == obj[2] -%}
            {%- set _= obj_pls.append(level) -%}
          {%- endif -%}
        {%- endfor -%}
        "performanceLevels": [
          {%- for level in obj_pls -%}
              {
                "assessmentReportingMethodDescriptor": "{{namespace}}AssessmentReportingMethodDescriptor#Progress Toward Career Readiness Indicator",
                "performanceLevelDescriptor": "{{ level.performanceLevelDescriptor }}",
                "performanceLevelMet": true
              }{%- if not loop.last -%},{%- endif -%}
          {%- endfor -%}
        ],
        "scoreResults": [
         {%- for score in all_score_obj -%}
          {
            "assessmentReportingMethodDescriptor": "{{namespace}}AssessmentReportingMethodDescriptor#{{score[0]}}",
            "resultDatatypeTypeDescriptor": "{{descriptor_namespace}}/ResultDatatypeTypeDescriptor#{{score[2]}}",
            "result": "{{score[1]}}"
          }{%- if not loop.last -%},{%- endif -%}
         {%- endfor -%}
        ]
      }
      {%- endif -%}
      {%- endfor -%}
      {%- for item in fromjson(v_student_objective_assessments | default('[]', true)) -%}
        {{ obj_comma() }}
        {
         "objectiveAssessmentReference": {
           "assessmentIdentifier": "{{ assessment_identifier }}",
           "identificationCode": "{{ item.objectiveAssessmentReference.identificationCode.replace('THE-', '').replace('-', '_') }}",
           "namespace": "{{ namespace }}"
         },
         "performanceLevels": {{ item.performanceLevels | default([], true) | tojson }},
         "scoreResults": {{ item.scoreResults | default([], true) | tojson }}
        }
      {%- endfor -%}
    ]
  }

